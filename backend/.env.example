# AI-Powered Log Analyzer Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Provider Configuration (Choose One)
# ===========================================

# Option 1: OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Option 2: Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Default provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# ===========================================
# VictoriaLogs Configuration
# ===========================================
VICTORIALOGS_URL=http://localhost:9428
VICTORIALOGS_TIMEOUT=30

# ===========================================
# Vector Database Configuration
# ===========================================
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=incident_memory

# ===========================================
# Application Settings
# ===========================================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ===========================================
# Git Integration (Optional)
# ===========================================
GIT_REPO_PATH=./repos
GITHUB_TOKEN=your-github-token-here

# ===========================================
# Confluence Integration (Optional)
# ===========================================
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACE_KEY=INCIDENTS
